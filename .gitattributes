# Exclude repo/dev-only files from the release archives GitHub generates
# (the plugin-update-checker downloads those zipballs, so anything listed
# here never reaches the WordPress installs).
/.github        export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/.DS_Store      export-ignore
/.planning      export-ignore
/.claude        export-ignore
/tests          export-ignore
